{
  "manifest_version": 3,
  "name": "SPX Operations Tools",
  "version": "1.7.2",
  "description": "SPX Operations Tools với Be Vietnam Pro, FMS Audit, Delivery Performance và Pickup Assignment.",
  "content_scripts": [
    {
      "matches": [
        "https://spx.shopee.vn/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://spx.shopee.vn/*"
      ],
      "js": [
        "status-data.js",
        "ui.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openapi.seatalk.io/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
