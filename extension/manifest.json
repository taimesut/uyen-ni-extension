{
  "manifest_version": 3,
  "name": "SPX Operations Tools",
  "version": "1.3.0",
  "description": "FMS Audit và Export Delivery Performance trực tiếp trên spx.shopee.vn.",
  "content_scripts": [
    {
      "matches": [
        "https://spx.shopee.vn/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://spx.shopee.vn/*"
      ],
      "js": [
        "status-data.js",
        "ui.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}