{
  "manifest_version": 3,
  "name": "SPX Operations Tools",
  "version": "1.4.0",
  "description": "FMS Audit, Export Delivery Performance và gửi report JPG qua SeaTalk webhook trực tiếp trên spx.shopee.vn.",
  "content_scripts": [
    {
      "matches": [
        "https://spx.shopee.vn/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://spx.shopee.vn/*"
      ],
      "js": [
        "status-data.js",
        "ui.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openapi.seatalk.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}