{
  "manifest_version": 3,
  "name": "SPX Operations Tools",
  "version": "2.1.1",
  "description": "SPX Operations Tools: FMS, Pickup, Delivery Performance ngày/tháng và SeaTalk.",
  "content_scripts": [
    {
      "matches": [
        "https://spx.shopee.vn/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://spx.shopee.vn/*"
      ],
      "js": [
        "status-data.js",
        "ui.js",
        "menu.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openapi.seatalk.io/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "https://spx.shopee.vn/*"
      ]
    }
  ]
}
